<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <Version>1.0.0-beta.rc1</Version>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- needed for IDE0005 (unused usings) to run in the build; the public API is documented where it helps, not everywhere -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Authors>y114git</Authors>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <!-- One place for the G3MLib package version. -->
    <G3MLibVersion Condition="'$(G3MLibVersion)' == ''">1.1.3</G3MLibVersion>
  </PropertyGroup>
</Project>
