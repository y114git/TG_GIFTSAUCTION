<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:G3MStudio.Localization"
             xmlns:local="using:G3MStudio.Explorer"
             xmlns:ws="using:G3MStudio.Core.Workspace"
             x:Class="G3MStudio.Explorer.ExplorerView">
  <DockPanel>
    <!-- The buttons share the title row so the filter box keeps the full width of a narrow dock. -->
    <DockPanel DockPanel.Dock="Top" Margin="8,8,8,0">
      <Button Name="FilterOptions" DockPanel.Dock="Right" Margin="4,0,0,0" />
      <Button Name="ViewToggle" DockPanel.Dock="Right" Margin="4,0,0,0" />
      <TextBlock Name="Header" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </DockPanel>
    <TextBox Name="FilterBox" DockPanel.Dock="Top" Margin="8,8,8,8" PlaceholderText="{loc:Tr explorer.filter}" AutomationProperties.Name="{loc:Tr explorer.filter}" />
    <ScrollViewer Name="BreadcrumbScroll" DockPanel.Dock="Top" Margin="8,0,8,8" IsVisible="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <StackPanel Name="Breadcrumb" Orientation="Horizontal" Spacing="2" />
    </ScrollViewer>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Bg.Raised}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,2,0,0" Padding="8,2">
      <StackPanel Spacing="4">
        <DockPanel>
          <Button Name="OptionsFold" DockPanel.Dock="Right" Width="24" Height="24" MinWidth="24" MinHeight="24" Padding="0" BorderThickness="0" Background="Transparent" />
          <!-- The selected count follows the total on the same line and wraps below only when the whole text no longer fits. -->
          <WrapPanel VerticalAlignment="Center" ItemSpacing="12">
            <TextBlock Name="Footer" Classes="muted" FontSize="{DynamicResource FontSize.Caption}" />
            <TextBlock Name="SelectedCount" Classes="muted" IsVisible="False" FontSize="{DynamicResource FontSize.Caption}" />
          </WrapPanel>
        </DockPanel>
        <DockPanel Name="OptionsRow">
          <ToggleButton Name="ThumbToggle" DockPanel.Dock="Left" Margin="0,0,8,0" Padding="8,0" Content="{loc:Tr explorer.icons}" ToolTip.Tip="{loc:Tr explorer.iconsTip}" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Classes="muted" HorizontalAlignment="Center" Margin="0,0,0,-10" Text="{loc:Tr explorer.zoomLabel}" FontSize="{DynamicResource FontSize.Caption}" />
            <Slider Name="ZoomSlider" Minimum="50" Maximum="250" Value="100" ToolTip.Tip="{loc:Tr explorer.zoom}" AutomationProperties.Name="{loc:Tr explorer.zoom}" />
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>
    <!-- Clipped: a pinned heading pushed up by the next one must not draw over the filter box. -->
    <Grid ClipToBounds="True">
      <ListBox Name="List" Classes="NoMotion" Background="{DynamicResource Bg.Surface}">
        <ListBox.Styles>
          <Style Selector="ListBoxItem" x:DataType="ws:ExplorerRow">
            <Setter Property="MinHeight" Value="{DynamicResource Row.Height}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="ws:ExplorerRow">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="{Binding IndentDepth, Converter={x:Static local:ExplorerView.Indent}}">
              <TextBlock Name="RowChevron" Grid.Column="0" Width="16" Text="{Binding Chevron}" Classes="muted" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="&#x25CF;" Foreground="{Binding Colour, Converter={x:Static local:ExplorerView.ColourBrush}}" IsVisible="{Binding Colour, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" VerticalAlignment="Center" Margin="0,0,4,0" />
              <Image Name="Thumb" Grid.Column="2" IsVisible="False" Stretch="Uniform" Margin="0,0,8,0" />
              <TextBlock Grid.Column="3" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="4" Text="{Binding Count}" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding HasCount}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <!-- The category the top visible row belongs to stays pinned; a click folds or unfolds it. -->
      <Border Name="Sticky" IsVisible="False" VerticalAlignment="Top" Margin="0" Padding="8,0" Cursor="Hand" Background="{DynamicResource Bg.Raised}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" VerticalAlignment="Center">
          <TextBlock Name="StickyChevron" Width="16" Classes="muted" VerticalAlignment="Center" />
          <Image Name="StickyThumb" Grid.Column="1" IsVisible="False" Stretch="Uniform" Margin="0,0,8,0" />
          <TextBlock Name="StickyText" Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock Name="StickyCount" Grid.Column="3" Classes="muted" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <TextBlock Name="NoMatch" Classes="muted" IsVisible="False" Margin="12" TextWrapping="Wrap" VerticalAlignment="Top" />
    </Grid>
  </DockPanel>
</UserControl>
