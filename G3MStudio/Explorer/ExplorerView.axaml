<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:G3MStudio.Localization"
             xmlns:local="using:G3MStudio.Explorer"
             xmlns:ws="using:G3MStudio.Core.Workspace"
             x:Class="G3MStudio.Explorer.ExplorerView">
  <DockPanel>
    <TextBlock Name="Header" DockPanel.Dock="Top" Margin="8,6" TextTrimming="CharacterEllipsis" />
    <TextBox Name="FilterBox" DockPanel.Dock="Top" Margin="8,0,8,6" PlaceholderText="{loc:Tr explorer.filter}" />
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Bg.Raised}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,2,0,0" Padding="8,2">
      <TextBlock Name="Footer" Classes="muted" FontSize="{DynamicResource FontSize.Caption}" />
    </Border>
    <Grid>
      <ListBox Name="List" Background="{DynamicResource Bg.Surface}">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="4,0" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="ws:ExplorerRow">
            <Grid Height="24" ColumnDefinitions="Auto,*,Auto" Margin="{Binding Depth, Converter={x:Static local:ExplorerView.Indent}}">
              <TextBlock Grid.Column="0" Width="16" Text="{Binding Chevron}" Classes="muted" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Text="{Binding Count}" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding !IsItem}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Name="NoMatch" Classes="muted" IsVisible="False" Margin="12" TextWrapping="Wrap" VerticalAlignment="Top" />
    </Grid>
  </DockPanel>
</UserControl>
