<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>G3MStudio</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Precompiled code skips most JIT work at launch: time to first window 1.7 s to 0.55 s on a warm start, at the cost of a larger first extraction. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- A local release build can take the key from the untracked env file of the repo root: dotnet publish -p:SentryFromEnv=true. A build without that switch never reads it. -->
  <Target Name="ReadSentryDsnFromEnvFile" BeforeTargets="GetAssemblyAttributes" Condition="'$(SentryFromEnv)' == 'true' And '$(SentryDsn)' == '' And Exists('$(MSBuildThisFileDirectory)..\.env')">
    <PropertyGroup>
      <EnvText>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\.env'))</EnvText>
      <SentryDsn>$([System.Text.RegularExpressions.Regex]::Match($(EnvText), '(?m)^\s*SENTRY_DSN\s*=\s*["'']?([^"''\r\n]+)').Groups[1].Value.Trim())</SentryDsn>
    </PropertyGroup>
    <ItemGroup Condition="'$(SentryDsn)' != ''">
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>SentryDsn</_Parameter1>
        <_Parameter2>$(SentryDsn)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(SentryDsn)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SentryDsn</_Parameter1>
      <_Parameter2>$(SentryDsn)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Sentry" Version="6.12.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Dock.Avalonia" Version="12.1.0.13" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.13" />
    <PackageReference Include="Dock.Model.Avalonia" Version="12.1.0.13" />
    <ProjectReference Include="..\G3MStudio.Core\G3MStudio.Core.csproj" />
  </ItemGroup>

  <Target Name="KeepSingleFilePublishOutput" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <PublishedSymbol Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishedSymbol)" />
    <Delete Files="$(PublishDir)G3MLib.xml" />
  </Target>

</Project>
