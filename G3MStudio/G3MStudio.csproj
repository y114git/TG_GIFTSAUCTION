<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- OpenAlOutput reads buffers and the device list through pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>G3MStudio</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\G3MStudio.ico</ApplicationIcon>
    <!-- Profile-guided tier-0 code only slows the first calls of a window that is opened once; measured 10 to 40% on edits and filter typing. -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- Measured on a 92 MB data file with 23 tabs open, three runs each: the commit at the end fell by about 12 percent (1119-1163 to 954-1013 MB) and opening the file did not slow down. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="G3MStudio.Tests" />
    <!-- The default budget of the youngest generation is about 12 MB; a tab or an edit allocates that much, and each collection then walked a heap of several hundred MB for 20 to 45 ms. -->
  </ItemGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- A local release build can take SENTRY_DSN="key" from the untracked env file of the repo root, or from -p:SentryEnvFile=path: dotnet publish -p:SentryFromEnv=true. A build without that switch never reads it. -->
  <PropertyGroup>
    <SentryEnvFile Condition="'$(SentryEnvFile)' == ''">$(MSBuildThisFileDirectory)..\.env</SentryEnvFile>
  </PropertyGroup>

  <Target Name="ReadSentryDsnFromEnvFile" BeforeTargets="GetAssemblyAttributes" Condition="'$(SentryFromEnv)' == 'true' And '$(SentryDsn)' == '' And Exists('$(SentryEnvFile)')">
    <PropertyGroup>
      <EnvText>$([System.IO.File]::ReadAllText('$(SentryEnvFile)'))</EnvText>
      <SentryDsn>$([System.Text.RegularExpressions.Regex]::Match($(EnvText), '(?m)^\s*SENTRY_DSN\s*=\s*["'']?([^"''\r\n]+)').Groups[1].Value.Trim())</SentryDsn>
    </PropertyGroup>
    <ItemGroup Condition="'$(SentryDsn)' != ''">
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>SentryDsn</_Parameter1>
        <_Parameter2>$(SentryDsn)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!-- A publish without a key builds an app that never reports; say so instead of staying silent. -->
  <Target Name="WarnWithoutSentryKey" AfterTargets="Publish" Condition="'$(SentryDsn)' == ''">
    <Message Importance="high" Text="No crash report key was built in (set SentryDsn or publish with -p:SentryFromEnv=true): this build never sends crash reports." />
  </Target>

  <ItemGroup Condition="'$(SentryDsn)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SentryDsn</_Parameter1>
      <_Parameter2>$(SentryDsn)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\G3MStudio.ico" />
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="4.2.751201" />
    <PackageReference Include="Sentry" Version="7.0.0" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Dock.Avalonia" Version="12.1.5" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Dock.Model.Avalonia" Version="12.1.5" />
    <ProjectReference Include="..\G3MStudio.Core\G3MStudio.Core.csproj" />
  </ItemGroup>

  <Target Name="KeepSingleFilePublishOutput" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <PublishedSymbol Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishedSymbol)" />
    <Delete Files="$(PublishDir)G3MLib.xml" />
  </Target>

</Project>
