<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- OpenAlOutput reads buffers and the device list through pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>G3MStudio</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Profile-guided tier-0 code only slows the first calls of a window that is opened once; measured 10 to 40% on edits and filter typing. -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="G3MStudio.Tests" />
    <!-- The default budget of the youngest generation is about 12 MB; a tab or an edit allocates that much, and each collection then walked a heap of several hundred MB for 20 to 45 ms. -->
  </ItemGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- A local release build can take the key from the untracked env file of the repo root: dotnet publish -p:SentryFromEnv=true. A build without that switch never reads it. -->
  <Target Name="ReadSentryDsnFromEnvFile" BeforeTargets="GetAssemblyAttributes" Condition="'$(SentryFromEnv)' == 'true' And '$(SentryDsn)' == '' And Exists('$(MSBuildThisFileDirectory)..\.env')">
    <PropertyGroup>
      <EnvText>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\.env'))</EnvText>
      <SentryDsn>$([System.Text.RegularExpressions.Regex]::Match($(EnvText), '(?m)^\s*SENTRY_DSN\s*=\s*["'']?([^"''\r\n]+)').Groups[1].Value.Trim())</SentryDsn>
    </PropertyGroup>
    <ItemGroup Condition="'$(SentryDsn)' != ''">
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>SentryDsn</_Parameter1>
        <_Parameter2>$(SentryDsn)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(SentryDsn)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SentryDsn</_Parameter1>
      <_Parameter2>$(SentryDsn)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Sentry" Version="6.12.1" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Dock.Avalonia" Version="12.1.5" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Dock.Model.Avalonia" Version="12.1.5" />
    <ProjectReference Include="..\G3MStudio.Core\G3MStudio.Core.csproj" />
  </ItemGroup>

  <Target Name="KeepSingleFilePublishOutput" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <PublishedSymbol Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishedSymbol)" />
    <Delete Files="$(PublishDir)G3MLib.xml" />
  </Target>

</Project>
