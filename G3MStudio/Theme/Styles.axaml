<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:docking="using:G3MStudio.Docking"
        xmlns:dockc="using:Dock.Avalonia.Controls">
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Bg.Window}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
    <Setter Property="FontWeight" Value="{DynamicResource Font.Weight}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
  </Style>
  <!-- Button text is often a resource name; an underscore in it must not become an access key and vanish. -->
  <Style Selector="Button /template/ ContentPresenter"><Setter Property="RecognizesAccessKey" Value="False" /></Style>
  <!-- A list is framed by a thin quiet line, not the white theme default. -->
  <Style Selector="ListBox">
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Border.Width}" />
  </Style>
  <!-- List rows are one line of text: the theme default is more than twice as tall. -->
  <Style Selector="ListBoxItem">
    <Setter Property="MinHeight" Value="{DynamicResource Row.Height}" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- A row taller than its text keeps the text in the middle, selected or not. -->
  <Style Selector="ComboBoxItem"><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style Selector="TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter"><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <!-- Selected rows are filled with Selection.Bg: dark text keeps 4.5:1 on it (SelectionContrastTests). -->
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                  ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                  ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter,
                  ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                  ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                  ComboBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter,
                  TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter,
                  TreeViewItem:selected:pointerover /template/ ContentPresenter#PART_HeaderPresenter,
                  TreeViewItem:selected:pressed /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" />
  </Style>
  <!-- Sizes come from the tokens (Tokens.axaml, ThemeSizes): the density presets and Settings > Appearance > Sizes move them. -->
  <Style Selector="Button, ToggleButton, ComboBox, NumericUpDown"><Setter Property="MinHeight" Value="{DynamicResource Control.Height}" /></Style>
  <Style Selector="TextBox"><Setter Property="MinHeight" Value="{DynamicResource Control.Height}" /><Setter Property="FontSize" Value="{DynamicResource FontSize.Editor}" /></Style>
  <Style Selector="ScrollBar:vertical"><Setter Property="Width" Value="{DynamicResource Scrollbar.Width}" /></Style>
  <Style Selector="ScrollBar:horizontal"><Setter Property="Height" Value="{DynamicResource Scrollbar.Width}" /></Style>
  <Style Selector="ToolTip"><Setter Property="FontSize" Value="{DynamicResource Tooltip.Size}" /></Style>
  <Style Selector="PathIcon"><Setter Property="Width" Value="{DynamicResource Icon.Size}" /><Setter Property="Height" Value="{DynamicResource Icon.Size}" /></Style>
  <Style Selector="TabItem, dockc|DocumentTabStripItem, dockc|ToolTabStripItem"><Setter Property="MinHeight" Value="{DynamicResource Tab.Height}" /></Style>
  <Style Selector="GridSplitter"><Setter Property="Background" Value="{DynamicResource Border.Subtle}" /></Style>
  <Style Selector="Border.panel"><Setter Property="Padding" Value="{DynamicResource Panel.Padding}" /></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource Text.Muted}" /></Style>
  <Style Selector="TextBlock.accent"><Setter Property="Foreground" Value="{DynamicResource Text.Accent}" /></Style>
  <!-- The template paints the disabled border; the control itself reports the same brush. -->
  <Style Selector="Button:disabled"><Setter Property="BorderBrush" Value="{DynamicResource Disabled.Border}" /></Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Accent.Fill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Text.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <!-- The template paints the pressed and hover states on the presenter, so the fill is set there too: the primary button never falls back to grey. -->
  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent.Fill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Text.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Text.Accent}" />
  </Style>
  <!-- A mode menu of the image editor is filled while it is the one in use (same fills as a selected row). -->
  <Style Selector="DropDownButton.active">
    <Setter Property="Background" Value="{DynamicResource Selection.Bg}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" />
  </Style>
  <Style Selector="DropDownButton.active /template/ ContentPresenter#PART_ContentPresenter, DropDownButton.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Selection.Bg}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" />
  </Style>
  <!-- A preview tab shows its name in italics (design/shell.md 9.1). -->
  <Style Selector="dockc|DocumentTabStripItem">
    <Setter Property="FontStyle" Value="{Binding (docking:StudioDock.IsPreview), Converter={x:Static docking:StudioDock.ItalicWhenTrue}}" />
  </Style>
</Styles>
