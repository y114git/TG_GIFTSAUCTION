<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Token names and values: docs/research/g3m-design.md, "Proposed G3MStudio token set". -->
  <SolidColorBrush x:Key="Bg.Window" Color="#282828" />
  <SolidColorBrush x:Key="Bg.Surface" Color="#222222" />
  <SolidColorBrush x:Key="Bg.Sunken" Color="#1B1B1B" />
  <SolidColorBrush x:Key="Bg.Raised" Color="#2B3431" />
  <SolidColorBrush x:Key="Bg.Overlay" Color="#E6282828" />
  <SolidColorBrush x:Key="Border" Color="#039D5B" />
  <SolidColorBrush x:Key="Border.Subtle" Color="#3A4A43" />
  <SolidColorBrush x:Key="Hover" Color="#5A6370" />
  <SolidColorBrush x:Key="Pressed" Color="#4E5763" />
  <SolidColorBrush x:Key="Select" Color="#ECEDEF" />
  <SolidColorBrush x:Key="Selection.Bg" Color="#14523A" />
  <SolidColorBrush x:Key="Text" Color="#E8E9EB" />
  <SolidColorBrush x:Key="Text.Accent" Color="#6DE985" />
  <SolidColorBrush x:Key="Text.Muted" Color="#9CA3AF" />
  <SolidColorBrush x:Key="Accent.Fill" Color="#039D5B" />
  <SolidColorBrush x:Key="Danger" Color="#FF9F9F" />
  <SolidColorBrush x:Key="Danger.Fill" Color="#F44336" />
  <SolidColorBrush x:Key="Warning" Color="#FFB74D" />
  <SolidColorBrush x:Key="Success" Color="#6DE985" />
  <SolidColorBrush x:Key="Info" Color="#5599FF" />
  <SolidColorBrush x:Key="Disabled.Bg" Color="#333333" />
  <SolidColorBrush x:Key="Disabled.Text" Color="#888888" />
  <SolidColorBrush x:Key="Disabled.Border" Color="#555555" />
  <SolidColorBrush x:Key="Syntax.Keyword" Color="#5599FF" />
  <SolidColorBrush x:Key="Syntax.Boolean" Color="#5599FF" />
  <SolidColorBrush x:Key="Syntax.String" Color="#FFB74D" />
  <SolidColorBrush x:Key="Syntax.Number" Color="#6DE985" />
  <SolidColorBrush x:Key="Syntax.Comment" Color="#9CA3AF" />
  <SolidColorBrush x:Key="Syntax.Function" Color="#6FD3E0" />
  <SolidColorBrush x:Key="Syntax.Variable" Color="#C3A6FF" />
  <SolidColorBrush x:Key="Syntax.Constant" Color="#F78FB3" />
  <SolidColorBrush x:Key="Syntax.Asset" Color="#E6D37A" />
  <SolidColorBrush x:Key="Syntax.Operator" Color="#E8E9EB" />
  <SolidColorBrush x:Key="Syntax.Preprocessor" Color="#FF9F9F" />

  <!-- Every border is exactly 2 px (docs/design.md rule 2). -->
  <Thickness x:Key="Border.Width">2</Thickness>
  <CornerRadius x:Key="Radius.Control">4</CornerRadius>
  <CornerRadius x:Key="Radius.Panel">6</CornerRadius>
  <CornerRadius x:Key="Radius.Window">7</CornerRadius>

  <x:Double x:Key="FontSize.Caption">11</x:Double>
  <x:Double x:Key="FontSize.Small">12</x:Double>
  <x:Double x:Key="FontSize.Body">13</x:Double>
  <x:Double x:Key="FontSize.Title">16</x:Double>
  <x:Double x:Key="FontSize.Display">20</x:Double>
  <FontFamily x:Key="Font.Body">Arial, Liberation Sans, sans-serif</FontFamily>
  <FontWeight x:Key="Font.Weight">Bold</FontWeight>
  <FontFamily x:Key="Font.Code">Noto Sans Mono, Cascadia Mono, Consolas, monospace</FontFamily>
</ResourceDictionary>
